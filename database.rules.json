{
  "rules": {
    ".read": false,
    ".write": false,

    "organizers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "subscriptions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "organizations": {
      "$organizationId": {
        ".read": "auth != null && (data.child('ownerUid').val() === auth.uid || root.child('organizationMembers').child($organizationId).child(auth.uid).exists())",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && data.child('ownerUid').val() === auth.uid))",
        "pendingInvites": {
          "$emailKey": {
            ".read": "auth != null && (root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid || (auth.token.email != null && data.child('email').val() === auth.token.email))",
            ".write": "auth != null && (root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid || (auth.token.email != null && data.child('email').val() === auth.token.email && !newData.exists()))"
          }
        }
      }
    },

    "organizationMembers": {
      "$organizationId": {
        ".read": "auth != null && (root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid || root.child('organizationMembers').child($organizationId).child(auth.uid).exists())",
        "$uid": {
          ".write": "auth != null && (root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid || auth.uid === $uid)"
        }
      }
    },

    "organizationGroups": {
      "$organizationId": {
        ".read": "auth != null && (root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid || root.child('organizationMembers').child($organizationId).child(auth.uid).exists())",
        "$groupId": {
          ".write": "auth != null && root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid"
        }
      }
    },

    "organizationGroupMembers": {
      "$organizationId": {
        "$groupId": {
          ".read": "auth != null && (root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid || root.child('organizationMembers').child($organizationId).child(auth.uid).child('groupIds').child($groupId).val() === true || root.child('organizationGroupMembers').child($organizationId).child($groupId).child(auth.uid).exists())",
          "$uid": {
            ".write": "auth != null && (root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid || auth.uid === $uid)"
          }
        }
      }
    },

    "organizationEmailInvites": {
      "$emailKey": {
        ".read": "auth != null && (data.child('createdBy').val() === auth.uid || (auth.token.email != null && data.child('email').val() === auth.token.email))",
        ".write": "auth != null && ((!data.exists() && root.child('organizations').child(newData.child('organizationId').val()).child('ownerUid').val() === auth.uid && newData.child('createdBy').val() === auth.uid) || (data.exists() && data.child('createdBy').val() === auth.uid) || (data.exists() && auth.token.email != null && data.child('email').val() === auth.token.email))"
      }
    },

    "organizationInvites": {
      "$inviteCode": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('createdBy').val() === auth.uid && root.child('organizations').child(newData.child('organizationId').val()).child('ownerUid').val() === auth.uid) || (data.exists() && data.child('createdBy').val() === auth.uid) || (data.exists() && data.child('status').val() === 'pending' && newData.child('status').val() === 'accepted' && newData.child('acceptedBy').val() === auth.uid))"
      }
    },

    "userOrganizations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$organizationId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid)"
        }
      }
    },

    "organizerSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "groupSessions": {
      "$organizationId": {
        "$groupId": {
          ".read": "auth != null && (root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid || root.child('organizationMembers').child($organizationId).child(auth.uid).child('groupIds').child($groupId).val() === true || root.child('organizationGroupMembers').child($organizationId).child($groupId).child(auth.uid).exists())",
          "$code": {
            ".write": "auth != null && (root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid || root.child('organizationMembers').child($organizationId).child(auth.uid).child('groupIds').child($groupId).val() === true || root.child('organizationGroupMembers').child($organizationId).child($groupId).child(auth.uid).exists())",
            ".validate": "!newData.exists() || (newData.hasChildren(['code','name','ownerUid','status','createdAt','updatedAt']) && newData.child('code').val() === $code && newData.child('name').isString() && newData.child('name').val().length <= 120 && newData.child('ownerUid').isString() && newData.child('status').isString() && newData.child('createdAt').isNumber() && newData.child('updatedAt').isNumber())",
            "ownerEmail": {
              ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 320)"
            }
          }
        }
      }
    },

    "savedSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "questionBanks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "sessionPseudos": {
      "$code": {
        ".read": true,
        "$pseudoKey": {
          ".write": true
        }
      }
    },

    "sessions": {
      "$code": {
        ".read": true,
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || (data.exists() && (data.child('ownerUid').val() === auth.uid || (data.child('organizationId').isString() && root.child('organizations').child(data.child('organizationId').val()).child('ownerUid').val() === auth.uid) || (data.child('organizationId').isString() && data.child('groupId').isString() && root.child('organizationMembers').child(data.child('organizationId').val()).child(auth.uid).child('groupIds').child(data.child('groupId').val()).val() === true) || (data.child('organizationId').isString() && data.child('groupId').isString() && root.child('organizationGroupMembers').child(data.child('organizationId').val()).child(data.child('groupId').val()).child(auth.uid).exists()))))",

        "participants": {
          "$participantId": {
            ".read": true,
            ".write": "(data.exists() && newData.exists()) || (!data.exists() && newData.exists() && (root.child('sessions').child($code).child('participants').numChildren() < 10 || (root.child('subscriptions').child(root.child('sessions').child($code).child('ownerUid').val()).child('plan').val() === 'pro' && root.child('subscriptions').child(root.child('sessions').child($code).child('ownerUid').val()).child('status').val() !== 'inactive' && root.child('subscriptions').child(root.child('sessions').child($code).child('ownerUid').val()).child('status').val() !== 'canceled' && root.child('subscriptions').child(root.child('sessions').child($code).child('ownerUid').val()).child('status').val() !== 'cancelled' && root.child('subscriptions').child(root.child('sessions').child($code).child('ownerUid').val()).child('status').val() !== 'expired' && root.child('subscriptions').child(root.child('sessions').child($code).child('ownerUid').val()).child('status').val() !== 'unpaid' && root.child('sessions').child($code).child('participants').numChildren() < 50) || (root.child('subscriptions').child(root.child('sessions').child($code).child('ownerUid').val()).child('plan').val() === 'business' && root.child('subscriptions').child(root.child('sessions').child($code).child('ownerUid').val()).child('status').val() !== 'inactive' && root.child('subscriptions').child(root.child('sessions').child($code).child('ownerUid').val()).child('status').val() !== 'canceled' && root.child('subscriptions').child(root.child('sessions').child($code).child('ownerUid').val()).child('status').val() !== 'cancelled' && root.child('subscriptions').child(root.child('sessions').child($code).child('ownerUid').val()).child('status').val() !== 'expired' && root.child('subscriptions').child(root.child('sessions').child($code).child('ownerUid').val()).child('status').val() !== 'unpaid' && root.child('sessions').child($code).child('participants').numChildren() < 200) || (root.child('sessions').child($code).child('organizationId').isString() && root.child('sessions').child($code).child('groupId').isString() && (root.child('organizations').child(root.child('sessions').child($code).child('organizationId').val()).child('ownerUid').val() === root.child('sessions').child($code).child('ownerUid').val() || root.child('organizationMembers').child(root.child('sessions').child($code).child('organizationId').val()).child(root.child('sessions').child($code).child('ownerUid').val()).child('groupIds').child(root.child('sessions').child($code).child('groupId').val()).val() === true || root.child('organizationGroupMembers').child(root.child('sessions').child($code).child('organizationId').val()).child(root.child('sessions').child($code).child('groupId').val()).child(root.child('sessions').child($code).child('ownerUid').val()).exists()) && root.child('sessions').child($code).child('participants').numChildren() < 500)))",
            ".validate": "!newData.exists() || (newData.hasChildren(['id','name','joinedAt']) && newData.child('id').val() === $participantId && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 30 && newData.child('joinedAt').isNumber())",
            "answers": {
              "$questionIndex": {
                ".write": "root.child('sessions').child($code).child('participants').child($participantId).exists()"
              }
            },
            "answerTimes": {
              "$questionIndex": {
                ".write": "root.child('sessions').child($code).child('participants').child($participantId).exists()"
              }
            },
            "answerPoints": {
              "$questionIndex": {
                ".write": "root.child('sessions').child($code).child('participants').child($participantId).exists()"
              }
            },
            "score": {
              ".write": "root.child('sessions').child($code).child('participants').child($participantId).exists()"
            },
            "connected": {
              ".write": "root.child('sessions').child($code).child('participants').child($participantId).exists()"
            },
            "lastSeenAt": {
              ".write": "root.child('sessions').child($code).child('participants').child($participantId).exists()"
            }
          }
        }
      }
    },

    "emailQueue": {
      ".read": false,
      ".write": false
    },

    "stripeCustomers": {
      ".read": false,
      ".write": false
    }
  }
}