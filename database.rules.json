{
  "rules": {
    ".read": false,
    ".write": false,

    "organizers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['uid','email','role','active']) && newData.child('uid').val() === auth.uid && newData.child('role').val() === 'organizer' && newData.child('active').isBoolean()"
      }
    },

    "organizations": {
      "$organizationId": {
        ".read": "auth != null && (data.child('ownerUid').val() === auth.uid || root.child('organizationMembers').child($organizationId).child(auth.uid).exists())",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || data.child('ownerUid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['id','name','type','ownerUid','plan','active']) && newData.child('id').val() === $organizationId && newData.child('name').isString() && newData.child('name').val().length >= 2 && (newData.child('type').val() === 'company' || newData.child('type').val() === 'school' || newData.child('type').val() === 'association') && newData.child('ownerUid').isString() && (newData.child('plan').val() === 'free' || newData.child('plan').val() === 'pro' || newData.child('plan').val() === 'business' || newData.child('plan').val() === 'enterprise') && newData.child('active').isBoolean()"
      }
    },

    "organizationMembers": {
      "$organizationId": {
        ".read": "auth != null && root.child('organizationMembers').child($organizationId).child(auth.uid).exists()",
        ".validate": "newData.numChildren() <= 4",
        "$uid": {
          ".write": "auth != null && (root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid || (auth.uid === $uid && !data.exists()))"
        }
      }
    },

    "organizationGroups": {
      "$organizationId": {
        ".read": "auth != null && root.child('organizationMembers').child($organizationId).child(auth.uid).exists()",
        ".validate": "newData.numChildren() <= 3",
        "$groupId": {
          ".write": "auth != null && root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid"
        }
      }
    },

    "organizationGroupMembers": {
      "$organizationId": {
        ".read": "auth != null && root.child('organizationMembers').child($organizationId).child(auth.uid).exists()",
        "$groupId": {
          "$uid": {
            ".write": "auth != null && (root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid || auth.uid === $uid)"
          }
        }
      }
    },

    "organizationInvites": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('createdBy').val() === auth.uid && root.child('organizations').child(newData.child('organizationId').val()).child('ownerUid').val() === auth.uid) || (data.exists() && (data.child('createdBy').val() === auth.uid || (newData.child('acceptedBy').val() === auth.uid && data.child('status').val() === 'pending'))))"
      }
    },

    "userOrganizations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$organizationId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid)"
        }
      }
    },

    "organizerSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "$code": {
          ".validate": "newData.hasChildren(['code','name','createdAt','status']) && newData.child('code').val() === $code"
        }
      }
    },

    "questionBanks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "subscriptions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "stripeCustomers": {
      ".read": false,
      ".write": false
    },

    "sessionPseudos": {
      "$code": {
        ".read": "auth != null",
        "$pseudoKey": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid || root.child('sessions').child($code).child('ownerUid').val() === auth.uid)",
          ".validate": "!newData.exists() || (newData.hasChildren(['uid','name','normalized','reservedAt']) && newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 30 && newData.child('normalized').isString() && newData.child('reservedAt').isNumber())"
        }
      }
    },

    "sessions": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && root.child('organizers').child(auth.uid).child('active').val() === true && newData.child('ownerUid').val() === auth.uid) || (data.exists() && data.child('ownerUid').val() === auth.uid))",

        "ownerUid": {
          ".validate": "newData.isString() && ((!data.exists() && newData.val() === auth.uid) || newData.val() === data.val())"
        },

        "maxParticipants": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= (root.child('subscriptions').child(auth.uid).child('participantLimit').exists() ? root.child('subscriptions').child(auth.uid).child('participantLimit').val() : 10)"
        },

        "participants": {
          ".validate": "newData.numChildren() <= (root.child('sessions').child($code).child('maxParticipants').exists() ? root.child('sessions').child($code).child('maxParticipants').val() : 10)",
          "$participantId": {
            ".read": "auth != null",
            ".write": "auth != null && (auth.uid === $participantId || root.child('sessions').child($code).child('ownerUid').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.hasChildren(['id','name','joinedAt']) && newData.child('id').val() === $participantId && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 30)",

            "answers": {
              "$questionIndex": {
                ".write": "auth != null && auth.uid === $participantId && !data.exists()"
              }
            },

            "answerTimes": {
              "$questionIndex": {
                ".write": "auth != null && auth.uid === $participantId"
              }
            },

            "answerPoints": {
              "$questionIndex": {
                ".write": "auth != null && auth.uid === $participantId",
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
              }
            },

            "score": {
              ".write": "auth != null && auth.uid === $participantId",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000 && (!data.exists() || newData.val() >= data.val())"
            }
          }
        }
      }
    },

    "savedSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
