{
  "rules": {
    ".read": false,
    ".write": false,

    "organizers": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || (newData.hasChildren(['uid','email','role','active']) && newData.child('uid').val() === $uid && newData.child('email').isString() && newData.child('role').val() === 'organizer' && newData.child('active').isBoolean())"
      }
    },

    "subscriptions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "organizations": {
      "$organizationId": {
        ".read": "auth != null && (data.child('ownerUid').val() === auth.uid || root.child('organizationMembers').child($organizationId).child(auth.uid).exists())",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid) || data.child('ownerUid').val() === auth.uid)",
        "pendingInvites": {
          "$emailKey": {
            ".read": "auth != null && root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid",
            ".write": "auth != null && root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid"
          }
        }
      }
    },

    "organizationMembers": {
      "$organizationId": {
        ".read": "auth != null && (root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid || root.child('organizationMembers').child($organizationId).child(auth.uid).exists())",
        "$uid": {
          ".write": "auth != null && (root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid || auth.uid === $uid)"
        }
      }
    },

    "organizationGroups": {
      "$organizationId": {
        ".read": "auth != null && (root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid || root.child('organizationMembers').child($organizationId).child(auth.uid).exists())",
        "$groupId": {
          ".write": "auth != null && root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid"
        }
      }
    },

    "organizationGroupMembers": {
      "$organizationId": {
        "$groupId": {
          ".read": "auth != null && (root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid || root.child('organizationGroupMembers').child($organizationId).child($groupId).child(auth.uid).exists())",
          "$uid": {
            ".write": "auth != null && (root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid || auth.uid === $uid)"
          }
        }
      }
    },

    "organizationEmailInvites": {
      "$emailKey": {
        ".read": "auth != null && (data.child('createdBy').val() === auth.uid || (auth.token.email != null && data.child('email').val() === auth.token.email))",
        ".write": "auth != null && ((!data.exists() && root.child('organizations').child(newData.child('organizationId').val()).child('ownerUid').val() === auth.uid && newData.child('createdBy').val() === auth.uid) || (data.exists() && data.child('createdBy').val() === auth.uid) || (data.exists() && auth.token.email != null && data.child('email').val() === auth.token.email))"
      }
    },

    "userOrganizations": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$organizationId": {
          ".write": "auth != null && (auth.uid === $uid || root.child('organizations').child($organizationId).child('ownerUid').val() === auth.uid)"
        }
      }
    },

    "organizerSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "savedSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "questionBanks": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "sessionPseudos": {
      "$code": {
        ".read": "auth != null",
        "$pseudoKey": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || data.child('uid').val() === auth.uid || root.child('sessions').child($code).child('ownerUid').val() === auth.uid)",
          ".validate": "!newData.exists() || (newData.hasChildren(['uid','name','normalized','reservedAt']) && newData.child('uid').val() === auth.uid && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 30 && newData.child('normalized').isString() && newData.child('reservedAt').isNumber())"
        }
      }
    },

    "sessions": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('ownerUid').val() === auth.uid && root.child('organizers').child(auth.uid).child('active').val() === true) || (data.exists() && data.child('ownerUid').val() === auth.uid))",

        "participants": {
          "$participantId": {
            ".read": "auth != null",
            ".write": "auth != null && (auth.uid === $participantId || root.child('sessions').child($code).child('ownerUid').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.hasChildren(['id','name','joinedAt']) && newData.child('id').val() === $participantId && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 30 && newData.child('joinedAt').isNumber())",

            "answers": {
              "$questionIndex": {
                ".write": "auth != null && auth.uid === $participantId && !data.exists()"
              }
            },
            "answerTimes": {
              "$questionIndex": {
                ".write": "auth != null && auth.uid === $participantId"
              }
            },
            "answerPoints": {
              "$questionIndex": {
                ".write": "auth != null && auth.uid === $participantId",
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
              }
            },
            "score": {
              ".write": "auth != null && auth.uid === $participantId",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "lastSeenAt": {
              ".write": "auth != null && auth.uid === $participantId",
              ".validate": "newData.isNumber()"
            },
            "connected": {
              ".write": "auth != null && auth.uid === $participantId",
              ".validate": "newData.isBoolean()"
            }
          }
        }
      }
    },

    "stripeCustomers": {
      ".read": false,
      ".write": false
    }
  }
}
